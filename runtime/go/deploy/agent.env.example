# chmod 0600 /etc/dozor-agent/agent.env, owner root.
DOZOR_TOKEN=replace_with_monitored_app_token
DOZOR_HOSTED_INGEST_URL=https://dozor.example.com/api/v1/ingest
# Optional if the HTTP Bearer token differs from app token:
# DOZOR_HOSTED_INGEST_TOKEN=replace_with_hosted_ingest_token
DOZOR_INGEST_URI=127.0.0.1:4815
DOZOR_APP_NAME=my-laravel-app
DOZOR_ENV=production
DOZOR_SERVER=web-1
DOZOR_AGENT_SPOOL_PATH=/var/lib/dozor-agent/spool
DOZOR_AGENT_STATE_PATH=/var/lib/dozor-agent/runtime-state.json
DOZOR_AGENT_SHIP_MAX_SPOOL_BATCHES=500
DOZOR_AGENT_SHIP_MAX_ATTEMPTS_PER_BATCH=8
DOZOR_AGENT_HEARTBEAT_INTERVAL_SECONDS=15
